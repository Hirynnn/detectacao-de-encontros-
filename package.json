{
  "name": "detector-de-encontros",
  "version": "1.0.0",
  "private": true,
  "description": "Deteccao de encontros por geolocalizacao com Node.js e TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "process": "node dist/index.js",
    "download": "npm run build && node dist/download.js",
    "validate": "node dist/validate.js",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "devDependencies": { "@types/node": "^22.10.0", "typescript": "^5.7.2" },
  "engines": { "node": ">=20" }
}
